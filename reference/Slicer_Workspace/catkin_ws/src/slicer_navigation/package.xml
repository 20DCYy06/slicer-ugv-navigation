<?xml version="1.0"?>
<package format="2">
  <name>slicer_navigation</name><version>0.2.0</version>
  <description>Noetic mapping, differential-drive TEB navigation, recording and verified multi-goal patrol.</description>
  <maintainer email="robot@example.invalid">potato</maintainer><license>BSD-3-Clause</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>rospy</depend><depend>geometry_msgs</depend><depend>nav_msgs</depend>
  <depend>sensor_msgs</depend><depend>std_msgs</depend><depend>std_srvs</depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <depend>visualization_msgs</depend>
  <depend>roscpp</depend><depend>rviz</depend><depend>pluginlib</depend>
  <depend>tf</depend><depend>actionlib</depend><depend>actionlib_msgs</depend><depend>move_base_msgs</depend>
  <exec_depend>move_base</exec_depend><exec_depend>amcl</exec_depend><exec_depend>gmapping</exec_depend>
  <exec_depend>map_server</exec_depend><depend>global_planner</depend>
  <depend>nav_core</depend><depend>base_local_planner</depend>
  <depend>tf2</depend><depend>tf2_geometry_msgs</depend>
  <exec_depend>teb_local_planner</exec_depend><depend>costmap_2d</depend>
  <exec_depend>clear_costmap_recovery</exec_depend>
  <exec_depend>rotate_recovery</exec_depend>
  <exec_depend>slicer_bringup</exec_depend><exec_depend>slicer_wasd_control</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>roslib</exec_depend><exec_depend>python3-rospkg</exec_depend>
  <export><rviz plugin="${prefix}/plugin_description.xml"/>
    <nav_core plugin="${prefix}/global_planner_plugin.xml"/>
  </export>
</package>
