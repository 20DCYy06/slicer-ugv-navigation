<launch>
  <!-- TEST_ONLY. No driver/Mux: run in a network-none, no-device container. -->
  <param name="use_sim_time" value="false"/>
  <arg name="local_planner" default="teb"/>
  <param name="TEST_ONLY_guard_planner/base_local_planner"
         value="$(eval {'teb': 'teb_local_planner/TebLocalPlannerROS', 'dwa': 'dwa_local_planner/DWAPlannerROS'}[arg('local_planner')])"/>
  <rosparam if="$(eval arg('local_planner') == 'teb')" ns="TEST_ONLY_guard_planner/TebLocalPlannerROS">
    max_vel_x: 0.125
    max_vel_x_backwards: 0.02
    max_vel_theta: 0.25
    acc_lim_x: 0.2
    acc_lim_theta: 1.0
  </rosparam>
  <rosparam if="$(eval arg('local_planner') == 'dwa')" ns="TEST_ONLY_guard_planner/DWAPlannerROS">
    max_vel_x: 0.125
    min_vel_x: 0.0
    max_vel_trans: 0.125
    max_vel_theta: 0.25
    acc_lim_x: 0.2
    acc_lim_trans: 0.2
    acc_lim_theta: 1.0
  </rosparam>
  <param name="TEST_ONLY_guard_planner/local_costmap/robot_base_frame"
         value="TEST_ONLY_guard_base"/>
  <rosparam param="TEST_ONLY_guard_planner/local_costmap/footprint">
    [[-0.165, -0.14], [-0.165, 0.14], [0.27, 0.14], [0.27, -0.14]]
  </rosparam>
  <node pkg="ugv_slicer_control" type="arc_velocity_guard.py"
        name="TEST_ONLY_guard" required="true" output="screen">
    <rosparam command="load" file="$(find ugv_bringup)/config/slicer_guard.yaml"/>
    <param name="config_file" value="$(find ugv_bringup)/config/test_slicer_guard.yaml"/>
    <param name="control_config_file" value="$(find ugv_bringup)/config/test_slicer_guard.yaml"/>
    <param name="planner_namespace" value="/TEST_ONLY_guard_planner"/>
    <param name="input_topic" value="/TEST_ONLY_guard/raw"/>
    <param name="output_topic" value="/TEST_ONLY_guard/output"/>
    <param name="costmap_topic" value="/TEST_ONLY_guard/grid"/>
    <param name="lio_topic" value="/TEST_ONLY_guard/lio"/>
  </node>
  <node pkg="ugv_slicer_control" type="arc_velocity_guard.py"
        name="TEST_ONLY_guard_boosted" required="true" output="screen">
    <rosparam command="load" file="$(find ugv_bringup)/config/slicer_guard.yaml"/>
    <param name="turn_compensation_enabled" value="true"/>
    <param name="config_file" value="$(find ugv_bringup)/config/test_slicer_guard.yaml"/>
    <param name="control_config_file" value="$(find ugv_bringup)/config/test_slicer_guard.yaml"/>
    <param name="planner_namespace" value="/TEST_ONLY_guard_planner"/>
    <param name="input_topic" value="/TEST_ONLY_guard/raw"/>
    <param name="output_topic" value="/TEST_ONLY_guard_boosted/output"/>
    <param name="costmap_topic" value="/TEST_ONLY_guard/grid"/>
    <param name="lio_topic" value="/TEST_ONLY_guard/lio"/>
  </node>
  <test pkg="ugv_slicer_control" type="test_guard_ros.py"
        test-name="guard_transport" time-limit="75.0"/>
</launch>
