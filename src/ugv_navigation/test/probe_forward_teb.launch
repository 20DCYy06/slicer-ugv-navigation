<launch>
  <!-- TEST_ONLY: each invocation needs a fresh tools/noetic.sh container/master. -->
  <arg name="initial_yaw" default="0.0"/>
  <arg name="goal_yaw" default="0.0"/>
  <arg name="inner_iterations" default="3"/>
  <arg name="overwrite_orientation" default="true"/>
  <arg name="output"/>
  <param name="use_sim_time" value="false"/>
  <include file="$(find ugv_bringup)/launch/slicer_odom.launch">
    <arg name="local_planner" value="teb"/>
    <arg name="connect_control" value="true"/>
    <arg name="source_config" value="$(find ugv_bringup)/config/test_control_chain.yaml"/>
    <arg name="control_config" value="$(find ugv_bringup)/config/test_control_chain.yaml"/>
    <arg name="raw_topic" value="/TEST_ONLY_chain/raw"/>
    <arg name="release_owner" value="/TEST_ONLY_chain_operator"/>
  </include>
  <param name="ugv/move_base/TebLocalPlannerROS/publish_feedback" value="true"/>
  <param name="ugv/move_base/TebLocalPlannerROS/no_inner_iterations" value="$(arg inner_iterations)"/>
  <param name="ugv/move_base/TebLocalPlannerROS/global_plan_overwrite_orientation"
         value="$(arg overwrite_orientation)"/>
  <node pkg="ugv_navigation" type="probe_forward_teb.py" name="TEST_ONLY_chain_operator"
        output="screen" required="true">
    <param name="initial_yaw" value="$(arg initial_yaw)"/>
    <param name="goal_yaw" value="$(arg goal_yaw)"/>
    <param name="output" value="$(arg output)"/>
  </node>
</launch>
